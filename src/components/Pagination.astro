---
import type { CollectionEntry } from 'astro:content'
import type { Page } from 'astro'

type Props = {
  page: Page<CollectionEntry<'blog'>>
}

const { page } = Astro.props

const pageUrl = (pageNumber: number) =>
  pageNumber === 1 ? '/blog' : `/blog/pages/${pageNumber}`

const pageNumbers = Array.from({ length: page.lastPage }, (_, i) => i + 1)

const buttonClass =
  'rounded-full px-5 py-2 font-bold text-gray-700 ring-2 ring-gray-200 transition hover:ring-gray-700 dark:text-white dark:ring-gray-400 dark:hover:ring-white'
---

<nav
  aria-label="Blog pagination"
  class="mt-12 grid grid-cols-[1fr_auto_1fr] items-center gap-4"
>
  {
    page.currentPage > 1 ? (
      <a
        href={pageUrl(page.currentPage - 1)}
        class:list={[buttonClass, 'justify-self-start']}
      >
        <span aria-hidden="true">&larr;</span> Newer
      </a>
    ) : (
      <span />
    )
  }

  <p class="sm:hidden">Page {page.currentPage} of {page.lastPage}</p>
  <ol class="hidden gap-1 sm:flex">
    {
      pageNumbers.map(pageNumber => (
        <li>
          <a
            href={pageUrl(pageNumber)}
            aria-current={pageNumber === page.currentPage ? 'page' : undefined}
            class:list={[
              'flex h-10 w-10 items-center justify-center rounded-full font-bold transition',
              pageNumber === page.currentPage
                ? 'bg-darkBlue text-white dark:bg-mainYellow dark:text-gray-700'
                : 'text-gray-500 hover:bg-white dark:text-gray-100 dark:hover:bg-gray-500',
            ]}
          >
            {pageNumber}
          </a>
        </li>
      ))
    }
  </ol>

  {
    page.currentPage < page.lastPage ? (
      <a
        href={pageUrl(page.currentPage + 1)}
        class:list={[buttonClass, 'justify-self-end']}
      >
        Older <span aria-hidden="true">&rarr;</span>
      </a>
    ) : (
      <span />
    )
  }
</nav>
