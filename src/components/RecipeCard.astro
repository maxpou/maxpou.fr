---
import { Picture } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'
import { recipeServings } from '../utils/recipeServings'

type Props = {
  recipe: CollectionEntry<'recipes'>
}

const { recipe } = Astro.props
const servings = recipeServings(recipe.body)
---

<a
  href={`/recipes/${recipe.data.slug}/`}
  class="group relative block overflow-hidden rounded-3xl bg-gray-700 shadow-sm transition hover:shadow-xl"
>
  <Picture
    src={recipe.data.cover}
    width={480}
    height={480}
    formats={['webp', 'avif', 'jpeg']}
    alt=""
    loading="lazy"
    decoding="async"
    class="aspect-square w-full object-cover transition duration-500 group-hover:scale-105"
  />
  {
    servings && (
      <span class="absolute top-3 right-3 rounded-full bg-white/90 px-3 py-1 text-xs font-bold text-gray-700 backdrop-blur">
        {servings} servings
      </span>
    )
  }
  <span
    class="absolute inset-x-0 bottom-0 bg-linear-to-t from-black/80 to-transparent p-4 pt-16 text-lg leading-snug font-bold text-white"
  >
    {recipe.data.title}
  </span>
</a>
