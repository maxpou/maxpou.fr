---
import { Image } from 'astro:assets'
import ProfilePicture from '../assets/profile-picture.jpeg'
---

<div
  class="not-prose flex flex-col items-center gap-5 rounded-2xl bg-white p-6 text-center shadow-sm ring-1 ring-black/5 sm:flex-row sm:items-start sm:gap-6 sm:text-left md:p-8 dark:bg-gray-500 dark:ring-white/10"
>
  <Image
    class="h-20 w-20 shrink-0 rounded-full object-cover"
    width={160}
    height={160}
    src={ProfilePicture}
    loading="lazy"
    alt="Maxence Poutord"
  />
  <div>
    <p
      class="text-xs font-bold uppercase tracking-wider text-gray-400 dark:text-gray-300"
    >
      Written by
    </p>
    <p class="mt-1 text-xl font-bold text-gray-700 dark:text-white">
      Maxence Poutord
    </p>
    <p
      class="mt-2 text-gray-500 dark:text-gray-100 [&_a]:underline [&_a]:underline-offset-2"
    >
      Hey, I'm Maxence Poutord, a senior software engineer at Orderfox. I'm
      also an indie hacker behind
      <a href="https://pedalyze.bike">Pedalyze</a> and
      <a href="https://youtube-mate.com">YoutubeMate</a>. When I'm not
      shipping, you can find me cooking, cycling or running. I'm also on
      <a href="https://twitter.com/_maxpou">Twitter</a>,
      <a href="https://bsky.app/profile/maxpou.fr">Bluesky</a>,
      <a href="https://github.com/maxpou">GitHub</a>, and
      <a href="https://www.linkedin.com/in/maxpou">LinkedIn</a>.
    </p>
  </div>
</div>
