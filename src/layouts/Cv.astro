---
import type { CvData, CvLabels } from '../content/cv'

interface Props {
  data: CvData
  labels: CvLabels
  pdfHref: string
}

const { data, labels, pdfHref } = Astro.props

const linkClasses = 'text-inherit underline underline-offset-[3px] [overflow-wrap:anywhere] hover:decoration-2 focus-visible:outline-2 focus-visible:outline-[#365d88] focus-visible:outline-offset-4 print:no-underline'
const sectionClasses = 'mt-[22px] print:mt-[12pt]'
const headingClasses = 'mb-[9px] border-b border-[#dce0e4] pb-1 text-[16px] font-bold print:mb-[5pt] print:border-[#999] print:pb-[3pt] print:text-[11pt] print:break-after-avoid'
const entryClasses = '[&+article]:mt-[18px] print:[&+article]:mt-[10pt]'
const subheadingClasses = 'text-[15px] font-bold print:text-[10pt] print:break-after-avoid'
const periodClasses = 'text-[13px] text-[#48515c] print:text-[9pt] print:text-black'
const bulletClasses = 'mt-[7px] list-disc pl-[19px] [&>li+li]:mt-1 print:mt-[4pt] print:[&>li+li]:mt-[2pt]'

function cleanupUrl(url: string) {
  return url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')
}
---

<nav class="mx-auto mt-6 mb-4 flex max-w-[860px] flex-wrap items-center justify-end gap-x-5 gap-y-3 px-6 text-[13px] [@media_screen_and_(max-width:600px)]:mt-4 [@media_screen_and_(max-width:600px)]:justify-start [@media_screen_and_(max-width:600px)]:px-5 print:hidden" aria-label={labels.title}>
  <a class={linkClasses} href={data.info.social.readme}>{labels.userManual}</a>
  {
    labels.otherLanguageUrl && (
      <a class={linkClasses} href={labels.otherLanguageUrl} hreflang={labels.otherLanguageCode}>
        {labels.otherLanguageLabel}
      </a>
    )
  }
  <a class={linkClasses} href={pdfHref} download>{labels.downloadPdf}</a>
  <button class="cursor-pointer rounded border border-[#20252b] bg-[#20252b] px-5 py-2 text-white focus-visible:outline-2 focus-visible:outline-[#365d88] focus-visible:outline-offset-4" type="button" onclick="window.print()">{labels.print}</button>
</nav>

<main class="mx-auto mb-12 max-w-[860px] border border-[#dce0e4] border-t-[5px] border-t-mainYellow bg-white px-[52px] py-11 [@media_screen_and_(max-width:600px)]:mb-0 [@media_screen_and_(max-width:600px)]:border-x-0 [@media_screen_and_(max-width:600px)]:px-5 [@media_screen_and_(max-width:600px)]:py-7 print:m-0 print:max-w-none print:border-0 print:p-0 print:[&_li]:break-inside-avoid print:[&_li]:[orphans:3] print:[&_li]:[widows:3] print:[&_p]:[orphans:3] print:[&_p]:[widows:3]">
  <header class="border-b border-[#9da5ae] pb-5 print:break-inside-avoid print:pb-[10pt]">
    <h1 class="text-[34px] leading-[1.15] font-bold tracking-[-0.8px] [@media_screen_and_(max-width:600px)]:text-[30px] print:text-[25pt]">{data.info.name}</h1>
    <p class="mt-1.5 mb-3.5 text-[20px] print:mt-[3pt] print:mb-[7pt] print:text-[14pt]">{data.info.title}</p>
    <address class="text-[13px] leading-[1.7] not-italic print:text-[9pt] print:text-black" aria-label={labels.about}>
      <p>{data.info.location}</p>
      <p>
        <a class={linkClasses} href={`mailto:${data.info.email}`}>{data.info.email}</a>
        <span class="whitespace-pre-wrap"> | </span>
        <a class={linkClasses} href={`tel:${data.info.phone}`}>{data.info.phone}</a>
      </p>
      <p>
        <a class={linkClasses} href={data.info.website}>{cleanupUrl(data.info.website)}</a>
        <span class="whitespace-pre-wrap"> | </span>
        <a class={linkClasses} href={data.info.social.github}>{cleanupUrl(data.info.social.github)}</a>
        <span class="whitespace-pre-wrap"> | </span>
        <a class={linkClasses} href={data.info.social.linkedin}>{cleanupUrl(data.info.social.linkedin)}</a>
      </p>
    </address>
  </header>

  <p class={sectionClasses}>{data.info.description}</p>

  <section class={sectionClasses} aria-labelledby="experience">
    <h2 class={headingClasses} id="experience">{labels.experience}</h2>
    {
      data.experiences.map(experience => (
        <article class={entryClasses}>
          <header class="print:break-after-avoid print:break-inside-avoid">
            <h3 class={subheadingClasses}>{experience.position}</h3>
            <p><strong>{experience.company}</strong> | {experience.location}</p>
            <p class={periodClasses}>{experience.period}</p>
          </header>
          {experience.activities.length > 0 && (
            <ul class={bulletClasses}>
              {experience.activities.map(activity => <li>{activity}</li>)}
            </ul>
          )}
        </article>
      ))
    }
  </section>

  <section class={sectionClasses} aria-labelledby="skills">
    <h2 class={headingClasses} id="skills">{labels.skills}</h2>
    <ul class="list-none p-0 [&>li+li]:mt-1 print:[&>li+li]:mt-[2pt]">
      {
        data.skills.map(skill => (
          <li><strong>{skill.category}:</strong> {skill.content.join(', ')}</li>
        ))
      }
    </ul>
  </section>

  <section class={sectionClasses} aria-labelledby="highlights">
    <h2 class={headingClasses} id="highlights">{labels.highlights}</h2>
    <ul class={bulletClasses}>
      {
        data.highlights.map(highlight => (
          <li>
            {highlight.content.map(part => (
              typeof part === 'string'
                ? part
                : <a class={linkClasses} href={part.url}>{part.label}</a>
            ))}
          </li>
        ))
      }
    </ul>
  </section>

  <section class={sectionClasses} aria-labelledby="education">
    <h2 class={headingClasses} id="education">{labels.education}</h2>
    {
      data.education.map(education => (
        <article class:list={[entryClasses, 'print:break-inside-avoid']}>
          <h3 class={subheadingClasses}>{education.degree}</h3>
          <p>{education.school} | {education.location}</p>
          <p class={periodClasses}>{education.period}</p>
        </article>
      ))
    }
  </section>

  <section class={sectionClasses} aria-labelledby="languages">
    <h2 class={headingClasses} id="languages">{labels.languages}</h2>
    <p>
      {
        data.languages.map(({ language, level }) => `${language}: ${level}`).join('; ')
      }
    </p>
  </section>

  <section class={sectionClasses} aria-labelledby="interests">
    <h2 class={headingClasses} id="interests">{labels.interests}</h2>
    <p>{data.interests}</p>
  </section>
</main>

<!-- Paged media settings have no Tailwind utility equivalent. -->
<style>
  @media print {
    @page {
      size: A4;
      margin: 14mm 16mm;
    }
  }
</style>
