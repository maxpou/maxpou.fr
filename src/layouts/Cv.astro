---
import { Image } from 'astro:assets'
import qrCode from '../assets/qr-code.png'
import EmailIcon from '../components/icons/Email'
import GithubIcon from '../components/icons/Github'
import LinkedinIcon from '../components/icons/Linkedin'
import PdfIcon from '../components/icons/Pdf'
import PrinterIcon from '../components/icons/Printer'
import WebIcon from '../components/icons/web'
import type { CvData, CvLabels } from '../content/cv'

interface Props {
  data: CvData
  labels: CvLabels
  pdfHref: string
  /** The QR code image is pre-generated, so it only fits the page it points to */
  showQrCode?: boolean
}

const { data, labels, pdfHref, showQrCode = false } = Astro.props

function cleanupUrl(url: string) {
  return url.replace('http://', '').replace('https://', '').replace('www.', '')
}
---

<main class="mx-auto mt-[15px] w-[90%] max-w-[770px] leading-snug">
  <aside class="hidden fixed top-0 right-0 md:flex flex-col p-4 gap-4">
    <button aria-label={labels.print} onclick="window.print()">
      <PrinterIcon />
    </button>
    <a href={pdfHref} aria-label={labels.downloadPdf} title={labels.title} download>
      <PdfIcon />
    </a>
  </aside>
  <header class="mb-2 bg-mainYellow p-2 text-center">
    <h1 class="pb-1 text-3xl font-bold">{data.info.name}</h1>
    <p class="text-lg">{data.info.title}</p>
  </header>
  {
    showQrCode && (
      <a
        href={data.info.cvUrl}
        class="relative float-right hidden flex-col items-center pl-2 md:flex"
      >
        <Image src={qrCode} alt="QR Code pointing to this page" class="w-24" />
        <span class="mt-[-5px] text-sm text-gray-500">
          {cleanupUrl(data.info.cvUrl)}
        </span>
      </a>
    )
  }
  <div class="mb-3">
    {data.info.description}
  </div>
  <div class="grid gap-1 grid-cols-1 md:grid-cols-[30fr_70fr]">
    <div>
      <section class="mb-3">
        <h2>{labels.about}</h2>
        <p>
          <a href=`tel:${data.info.phone}`>{data.info.phone}</a>
        </p>
        <p>
          <a
            href=`mailto:${data.info.email}`
            class="flex flex-row items-center gap-2 hover:underline"
          >
            <EmailIcon />
            {data.info.email}</a
          >
        </p>
        <p>
          <a
            href={data.info.website}
            target="_blank"
            rel="noopener noreferrer"
            class="flex flex-row items-center gap-2 hover:underline"
          >
            <WebIcon />
            {cleanupUrl(data.info.website)}</a
          >
        </p>
        <p>
          <a
            href={data.info.social.github}
            target="_blank"
            rel="noopener noreferrer"
            class="flex flex-row items-center gap-2 hover:underline"
          >
            <GithubIcon />
            {cleanupUrl(data.info.social.github)}</a
          >
        </p>
        <p>
          <a
            href={data.info.social.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="flex flex-row items-center gap-2 hover:underline"
          >
            <LinkedinIcon />
            {cleanupUrl(data.info.social.linkedin)}</a
          >
        </p>
        <p>
          <a
            href={data.info.social.readme}
            target="_blank"
            rel="noopener noreferrer"
            class="flex flex-row items-center gap-2 hover:underline"
          >
            <WebIcon />
            {labels.userManual}
          </a>
        </p>
        {labels.otherLanguageUrl && (
          <p>
            <a
              href={labels.otherLanguageUrl}
              hreflang={labels.otherLanguageCode}
              class="flex flex-row items-center gap-2 hover:underline print:hidden"
              >
              <WebIcon />
              {labels.otherLanguageLabel}
            </a>
          </p>
        )}
      </section>
      <section class="mb-3">
        <h2>{labels.skills}</h2>
        {
          data.skills.map((skillCategory, i) => (
            <div>
              <h3 class={`font-bold ${i !== 0 ? 'pt-2' : ''}`}>
                {skillCategory.category}
              </h3>
              <ul>
                {skillCategory.content.map(skill => (
                  <li class="pl-2">{skill}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </section>
      <section class="mb-3">
        <h2>{labels.languages}</h2>
        {
          data.languages.map((languagesCategory, i) => (
            <div>
              <h3 class={`font-bold ${i !== 0 ? 'pt-2' : ''}`}>
                {languagesCategory.level}
              </h3>
              <ul>
                {languagesCategory.languages.map(language => (
                  <li class="pl-2">{language}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </section>
      <section>
        <h2>{labels.interests}</h2>
        <div>{data.interests}</div>
      </section>
    </div>
    <div>
      <section>
        <h2 class="mt-2">{labels.highlights}</h2>
        <ul class="list-disc pl-5">
          {
            data.highlights.map(highlight => (
              <li>
                {highlight.description}
                {highlight.links.length > 0 && (
                  <span class="inline-block whitespace-nowrap text-sm">{` (${labels.see} `}{highlight.links.map((url, index) => (<>{index > 0 && ', '}<a class="inline-block underline text-blue-500 hover:text-blue-800" href={url}>{cleanupUrl(url)}</a></>))}{')'}</span>
                )}
              </li>
            ))
          }
        </ul>
      </section>
      <section class="experiences">
        <h2 class="mt-2">{labels.experience}</h2>
        <div>
          {
            data.experiences.map(experience => (
              <div class="experience pb-3 last:pb-0 last:mb-3">
                <div class="bull" />
                <h3 class="text-lg font-bold">{experience.position}</h3>
                <p class="text-neutral-500">{experience.period}</p>
                <p class="pb-2 text-neutral-500">
                  {experience.company}, {experience.location}
                </p>
                {experience.activities.length > 0 && (
                  <ul>
                    {experience.activities.map(activity => (
                      <li class="pb-1">{activity}</li>
                    ))}
                  </ul>
                )}
              </div>
            ))
          }
        </div>
      </section>
      <section>
        <h2>{labels.education}</h2>
        <div>
          {
            data.education.map(education => (
              <div class="experience pb-3 last:pb-0 last:mb-3">
                <div class="bull" />
                <h3 class="font-bold">{education.degree}</h3>
                <p class="text-neutral-500">{education.period}</p>
                <p class="pb-2 text-neutral-500">
                  {education.school}, {education.location}
                </p>
              </div>
            ))
          }
        </div>
      </section>
    </div>
  </div>
</main>
<style>
  body {
    font-size: 16px;
    line-height: 1.5;
    color: #3e4047; /* gray-500 */
  }
  main {
    margin-bottom: 20px;
    break-inside: avoid;
  }

  h2 {
    display: inline-block;
    margin-bottom: 10px;
    font-size: 24px;
    font-weight: bold;
    color: #3e4047;
    line-height: normal;
  }

  h2:after {
    content: '';
    display: block;
    width: 100%;
    height: 2px;
    margin-top: -1px;
    background-color: #ffdc4e;
  }

  .experience {
    border-left: 1px solid darkgray;
    padding-left: 12px;
    position: relative;
  }
  .experience::before {
    padding-left: 4px;
  }
  .bull {
    position: absolute;
    content: '';
    display: block;
    margin-top: 5px;
    width: 14px;
    height: 14px;
    left: -7px;
    top: 0;
    border-radius: 8px;
    border: 2px solid #ffdc4e;
    background-color: white;
  }

  @media print {
    @page {
      size: A4;
      margin: 10mm 17mm 10mm 17mm;
    }
    html,
    body {
      width: 210mm;
      height: 282mm;
      font-size: 14px;
      background: #fff;
      overflow: visible;
    }
    body {
      padding-top: 0mm;
    }

    .grid {
      /* otherwise grid not working when printing */
      grid-template-columns: 30fr 70fr;
    }

    section,
    div.experience {
      page-break-inside: avoid;
    }
    section.experiences {
      page-break-inside: initial;
    }
  }
</style>
