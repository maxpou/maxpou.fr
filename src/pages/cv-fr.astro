---
import BaseHead from '../components/BaseHead.astro'
import { SITE_URL } from '../consts'
import { cvDataFr, cvLabelsFr } from '../content/cv-fr'
import Cv from '../layouts/Cv.astro'
---

<html class="scheme-light bg-[#f3f4f5] print:bg-white print:text-[10pt] print:leading-[1.35]! print:text-black" lang="fr">
  <head>
    <BaseHead
      title="CV de Maxence Poutord"
      description="Maxence Poutord, ingénieur logiciel français avec plus de 15 ans d'expérience dans le développement d'applications web"
      translations={[
        { url: `${SITE_URL}/cv`, lang: 'en' },
        { url: `${SITE_URL}/cv-fr`, lang: 'fr' },
      ]}
    />
  </head>
  <body class="[font-family:Arial,Helvetica,sans-serif]! text-[15px] leading-[1.5]! text-[#20252b] print:bg-white print:text-[10pt] print:leading-[1.35]! print:text-black">
    <Cv
      data={cvDataFr}
      labels={cvLabelsFr}
      pdfHref="../Maxence-Poutord-Resume.pdf"
    />
  </body>
</html>
