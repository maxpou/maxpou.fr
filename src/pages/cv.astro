---
import BaseHead from '../components/BaseHead.astro'
import { SITE_URL } from '../consts'
import { cvData, cvLabels } from '../content/cv'
import Cv from '../layouts/Cv.astro'
---

<html class="scheme-light bg-[#f3f4f5] print:bg-white print:text-[10pt] print:leading-[1.35]! print:text-black" lang="en">
  <head>
    <BaseHead
      title="Maxence Poutord Resume"
      description="Maxence Poutord, a French Software Engineer with +15 years of experience developing web-based applications"
      translations={[
        { url: `${SITE_URL}/cv`, lang: 'en' },
        { url: `${SITE_URL}/cv-fr`, lang: 'fr' },
      ]}
    />
  </head>
  <body class="[font-family:Arial,Helvetica,sans-serif]! text-[15px] leading-[1.5]! text-[#20252b] print:bg-white print:text-[10pt] print:leading-[1.35]! print:text-black">
    <Cv
      data={cvData}
      labels={cvLabels}
      pdfHref="../Maxence-Poutord-Resume.pdf"
    />
  </body>
</html>
