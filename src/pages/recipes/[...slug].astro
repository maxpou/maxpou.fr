---
import { type CollectionEntry, getCollection, render } from 'astro:content'
import Prose from '../../components/Prose.astro'
import StructuredData from '../../components/StructuredData.astro'
import Page from '../../layouts/Page.astro'
import { buildRecipeSchema } from '../../utils/recipeSchema'

export async function getStaticPaths() {
  const recipes = await getCollection('recipes')
  return recipes.map(recipe => ({
    params: { slug: recipe.data.slug },
    props: recipe,
  }))
}
type Props = CollectionEntry<'recipes'>

const recipe = {
  ...Astro.props,
  data: {
    ...Astro.props.data,
    description: `${Astro.props.data.title}, a cooking recipe by Maxence Poutord`,
  },
}
const { Content } = await render(recipe)

const recipeStructuredData = buildRecipeSchema({
  title: recipe.data.title,
  description: recipe.data.description,
  date: recipe.data.date,
  cover: recipe.data.cover?.src,
  body: recipe.body,
  url: Astro.url.toString(),
})
---

<Page {...recipe}>
  <StructuredData data={recipeStructuredData} />
  <Prose>
    <Content />
    <div class="mt-6">
      <a href="../">← Back to recipes</a>
    </div>
  </Prose>
</Page>
