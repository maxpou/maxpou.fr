---
import { type CollectionEntry, getCollection, render } from 'astro:content'
import Prose from '../../components/Prose.astro'
import RecipeTagIcon from '../../components/RecipeTagIcon.astro'
import StructuredData from '../../components/StructuredData.astro'
import Page from '../../layouts/Page.astro'
import { buildRecipeSchema } from '../../utils/recipeSchema'

export async function getStaticPaths() {
  const recipes = await getCollection('recipes')
  return recipes.map(recipe => ({
    params: { slug: recipe.data.slug },
    props: recipe,
  }))
}
type Props = CollectionEntry<'recipes'>

const recipe = {
  ...Astro.props,
  data: {
    ...Astro.props.data,
    description: `${Astro.props.data.title}, a cooking recipe by Maxence Poutord`,
  },
}
const { Content } = await render(recipe)

const recipeStructuredData = buildRecipeSchema({
  title: recipe.data.title,
  description: recipe.data.description,
  date: recipe.data.date,
  cover: recipe.data.cover?.src,
  body: recipe.body,
  url: Astro.url.toString(),
})
---

<Page {...recipe}>
  <StructuredData data={recipeStructuredData} />
  {
    recipe.data.tags.length > 0 && (
      <ul class="mt-6 flex flex-wrap justify-center gap-2">
        {recipe.data.tags.map(tag => (
          <li class="inline-flex items-center gap-1.5 rounded-full bg-white px-3 py-1 text-sm font-bold text-darkBlue ring-1 ring-gray-100 dark:bg-gray-500 dark:text-gray-100 dark:ring-white/10">
            <RecipeTagIcon tag={tag} />
            {tag}
          </li>
        ))}
      </ul>
    )
  }
  <Prose>
    <Content />
    <div class="mt-6">
      <a href="../">← Back to recipes</a>
    </div>
  </Prose>
</Page>
